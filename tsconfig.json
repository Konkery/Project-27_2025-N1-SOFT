{
  "compilerOptions": {
    "esModuleInterop": true, 
    "allowSyntheticDefaultImports": true,
    "target": "es2025",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "./js",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    // "outDir": "./dist",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "js/**/*"
  ]
}