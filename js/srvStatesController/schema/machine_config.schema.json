{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MachineConfig",
  "description": "JSON Schema для аппаратной конфигурации вендингового аппарата (MachineConfig)",
  "type": "object",
  "properties": {
    "Global": {
      "description": "Глобальные параметры аппарата",
      "$ref": "#/definitions/GlobalConfig"
    },
    "Power": {
      "description": "Конфигурация подсистемы электропитания",
      "$ref": "#/definitions/PowerConfig"
    },
    "Env": {
      "description": "Конфигурация подсистемы климатического контроля",
      "$ref": "#/definitions/EnvConfig"
    },
    "Net": {
      "description": "Сетевая конфигурация аппарата",
      "$ref": "#/definitions/NetConfig"
    },
    "Field": {
      "description": "Конфигурация полевых шин (RS485, CAN, TCP)",
      "$ref": "#/definitions/FieldBusesConfig"
    },
    "IO": {
      "type": "array",
      "description": "Список конфигураций модулей ввода/вывода (IO)",
      "items": {
        "$ref": "#/definitions/IoModuleConfig"
      }
    },
    "Camera": {
      "type": "array",
      "description": "Список конфигураций систем фотовидеоконтроля (камер)",
      "items": {
        "$ref": "#/definitions/CameraConfig"
      }
    },
    "Sections": {
      "type": "array",
      "description": "Список конфигураций секций аппарата",
      "items": {
        "$ref": "#/definitions/SectionConfig"
      }
    }
  },
  "required": [
    "Global",
    "Power",
    "Env",
    "Net",
    "Field",
    "IO",
    "Camera",
    "Sections"
  ],
  "additionalProperties": false,
  "definitions": {
    "SECTION_TYPE": {
      "title": "SECTION_TYPE",
      "description": "Тип секции вендингового аппарата (POST - постомат, SPIRAL - спиральная секция, WEIGHT - весовая секция приёма лома, DOZER - диспенсер сыпучих/жидких материалов)",
      "type": "string",
      "enum": ["POST", "SPIRAL", "WEIGHT", "DOZER"],
      "tsEnumNames": ["POST", "SPIRAL", "WEIGHT", "DOZER"]
    },
    "BATTERY_TYPE": {
      "title": "BATTERY_TYPE",
      "description": "Тип аккумулятора (lipo - литий-полимерный, lead - свинцово-кислотный)",
      "type": "string",
      "enum": ["lipo", "lead"],
      "tsEnumNames": ["LIPO", "LEAD"]
    },
    "WAN_MODE": {
      "title": "WAN_MODE",
      "description": "Режим работы WAN-порта (static - статический IP, dhcp - динамический IP)",
      "type": "string",
      "enum": ["static", "dhcp"],
      "tsEnumNames": ["STATIC", "DHCP"]
    },
    "FieldRef": {
      "title": "FieldRef",
      "description": "Ссылка на подключение устройства к полевой шине",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "description": "Ссылка на полевую шину (например, 'Field/RS485/0')"
        },
        "ID": {
          "type": "string",
          "description": "Адрес устройства на шине"
        }
      },
      "required": ["ref", "ID"],
      "additionalProperties": false
    },
    "GlobalConfig": {
      "title": "GlobalConfig",
      "description": "Глобальные параметры идентификации аппарата",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Уникальный идентификатор аппарата (UID)"
        },
        "Model": {
          "type": "string",
          "description": "Модель аппарата"
        },
        "StartDate": {
          "type": "string",
          "description": "Дата ввода в эксплуатацию (ГГГГ-ММ-ДД)"
        }
      },
      "required": ["ID", "Model", "StartDate"],
      "additionalProperties": false
    },
    "MainsConfig": {
      "title": "MainsConfig",
      "description": "Параметры электропитания сети переменного тока",
      "type": "object",
      "properties": {
        "Voltage": {
          "type": "number",
          "description": "Номинальное сетевое напряжение, В (по умолчанию 230)"
        },
        "VoltageMin": {
          "type": "number",
          "description": "Минимально допустимое сетевое напряжение, В (по умолчанию 170)"
        },
        "VoltageMax": {
          "type": "number",
          "description": "Максимально допустимое сетевое напряжение, В (по умолчанию 250)"
        },
        "PowerMax": {
          "type": "number",
          "description": "Максимальная потребляемая мощность аппарата, Вт (по умолчанию 200)"
        }
      },
      "required": ["Voltage", "VoltageMin", "VoltageMax", "PowerMax"],
      "additionalProperties": false
    },
    "BatteryConfig": {
      "title": "BatteryConfig",
      "description": "Параметры резервной аккумуляторной батареи",
      "type": "object",
      "properties": {
        "Model": {
          "type": "string",
          "description": "Модель батареи"
        },
        "type": {
          "$ref": "#/definitions/BATTERY_TYPE"
        },
        "Voltage": {
          "type": "number",
          "description": "Номинальное напряжение батареи, В"
        },
        "Capacity": {
          "type": "number",
          "description": "Ёмкость батареи, Ач"
        }
      },
      "required": ["Model", "type", "Voltage", "Capacity"],
      "additionalProperties": false
    },
    "PsuConfig": {
      "title": "PsuConfig",
      "description": "Конфигурация источника питания (ИП / PSU)",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение источника питания на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель источника питания"
        },
        "Bus": {
          "type": "number",
          "description": "Номер подключенной шины электропитания"
        },
        "VoltageIn": {
          "type": "number",
          "description": "Входное напряжение, В (по умолчанию 230)"
        },
        "VoltageOut": {
          "type": "number",
          "description": "Выходное напряжение, В"
        },
        "CurrentMax": {
          "type": "number",
          "description": "Ограничение максимального выходного тока, А"
        },
        "Battery": {
          "$ref": "#/definitions/BatteryConfig"
        },
        "Field": {
          "$ref": "#/definitions/FieldRef"
        }
      },
      "required": [
        "RefDes",
        "Model",
        "Bus",
        "VoltageIn",
        "VoltageOut",
        "CurrentMax",
        "Field"
      ],
      "additionalProperties": false
    },
    "BusConfig": {
      "title": "BusConfig",
      "description": "Конфигурация шины электропитания",
      "type": "object",
      "properties": {
        "source": {
          "type": "number",
          "description": "Индекс источника питания (0 - шина сетевого питания Mains)"
        },
        "sink": {
          "type": "array",
          "description": "Список подключенных к шине устройств",
          "items": {
            "type": "string"
          }
        },
        "Voltage": {
          "type": ["number", "string"],
          "description": "Номинальное напряжение шины, В"
        },
        "CurrentMax": {
          "type": ["number", "string"],
          "description": "Максимально допустимый ток шины, А"
        }
      },
      "required": ["source", "sink", "Voltage", "CurrentMax"],
      "additionalProperties": false
    },
    "PowerConfig": {
      "title": "PowerConfig",
      "description": "Конфигурация подсистемы электропитания аппарата",
      "type": "object",
      "properties": {
        "Mains": {
          "$ref": "#/definitions/MainsConfig"
        },
        "PSU": {
          "type": "array",
          "description": "Список источников питания (PSU)",
          "items": {
            "$ref": "#/definitions/PsuConfig"
          }
        },
        "Bus": {
          "type": "array",
          "description": "Список шин распределения электропитания",
          "items": {
            "$ref": "#/definitions/BusConfig"
          }
        }
      },
      "required": ["Mains", "PSU", "Bus"],
      "additionalProperties": false
    },
    "TempSensorConfig": {
      "title": "TempSensorConfig",
      "description": "Конфигурация датчика температуры",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение датчика температуры на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель датчика температуры"
        },
        "Min": {
          "type": "number",
          "description": "Минимальная рабочая температура, °C (по умолчанию 0)"
        },
        "Max": {
          "type": "number",
          "description": "Максимальная рабочая температура, °C (по умолчанию 40)"
        },
        "Field": {
          "$ref": "#/definitions/FieldRef"
        }
      },
      "required": ["RefDes", "Model", "Min", "Max", "Field"],
      "additionalProperties": false
    },
    "HumSensorConfig": {
      "title": "HumSensorConfig",
      "description": "Конфигурация датчика влажности",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение датчика влажности на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель датчика влажности"
        },
        "Min": {
          "type": "number",
          "description": "Минимальная рабочая влажность, % (по умолчанию 10)"
        },
        "Max": {
          "type": "number",
          "description": "Максимальная рабочая влажность, % (по умолчанию 80)"
        },
        "Field": {
          "$ref": "#/definitions/FieldRef"
        }
      },
      "required": ["RefDes", "Model", "Min", "Max", "Field"],
      "additionalProperties": false
    },
    "FanConfig": {
      "title": "FanConfig",
      "description": "Конфигурация вентилятора охлаждения",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение вентилятора на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель вентилятора"
        },
        "PWM": {
          "type": "number",
          "description": "Максимальная скорость вращения (ШИМ)"
        },
        "Field": {
          "$ref": "#/definitions/FieldRef"
        }
      },
      "required": ["RefDes", "Model", "PWM", "Field"],
      "additionalProperties": false
    },
    "EnvConfig": {
      "title": "EnvConfig",
      "description": "Конфигурация подсистемы климатического контроля",
      "type": "object",
      "properties": {
        "Temp": {
          "type": "array",
          "description": "Список датчиков температуры",
          "items": {
            "$ref": "#/definitions/TempSensorConfig"
          }
        },
        "Hum": {
          "type": "array",
          "description": "Список датчиков влажности",
          "items": {
            "$ref": "#/definitions/HumSensorConfig"
          }
        },
        "Fan": {
          "type": "array",
          "description": "Список вентиляторов",
          "items": {
            "$ref": "#/definitions/FanConfig"
          }
        }
      },
      "required": ["Temp", "Hum", "Fan"],
      "additionalProperties": false
    },
    "RS485BusConfig": {
      "title": "RS485BusConfig",
      "description": "Конфигурация полевой шины RS485 (MODBUS/RTU)",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение шины на монтажной схеме"
        },
        "Master": {
          "type": "string",
          "description": "Мастер-устройство ('hub-low', 'icpcon1' и т.д.)"
        },
        "Port": {
          "type": "string",
          "description": "Имя порта на мастере или 'ip:port'"
        },
        "Baud": {
          "type": "number",
          "description": "Скорость работы порта (бод)"
        },
        "sink": {
          "type": "array",
          "description": "Список подключенных устройств на шине",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["RefDes", "Master", "Port", "Baud", "sink"],
      "additionalProperties": false
    },
    "CanBusConfig": {
      "title": "CanBusConfig",
      "description": "Конфигурация полевой шины CAN",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение шины на монтажной схеме"
        },
        "sink": {
          "type": "array",
          "description": "Список подключенных устройств к шине CAN",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["RefDes", "sink"],
      "additionalProperties": false
    },
    "TcpBusConfig": {
      "title": "TcpBusConfig",
      "description": "Конфигурация сетевой полевой шины MODBUS/TCP",
      "type": "object",
      "properties": {
        "SubNet": {
          "type": "string",
          "description": "Подсеть MODBUS/TCP"
        },
        "sink": {
          "type": "array",
          "description": "Список подключенных устройств в подсети",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["SubNet", "sink"],
      "additionalProperties": false
    },
    "FieldBusesConfig": {
      "title": "FieldBusesConfig",
      "description": "Конфигурация полевых шин аппарата",
      "type": "object",
      "properties": {
        "RS485": {
          "type": "array",
          "description": "Список шин RS485",
          "items": {
            "$ref": "#/definitions/RS485BusConfig"
          }
        },
        "CAN": {
          "type": "array",
          "description": "Список шин CAN",
          "items": {
            "$ref": "#/definitions/CanBusConfig"
          }
        },
        "TCP": {
          "type": "array",
          "description": "Список шин MODBUS/TCP",
          "items": {
            "$ref": "#/definitions/TcpBusConfig"
          }
        }
      },
      "required": ["RS485", "CAN", "TCP"],
      "additionalProperties": false
    },
    "IoPinSink": {
      "title": "IoPinSink",
      "description": "Привязка вывода модуля ввода-вывода к устройству",
      "type": "object",
      "properties": {
        "sink": {
          "type": "string",
          "description": "Формат 'устройство:вывод'"
        }
      },
      "required": ["sink"],
      "additionalProperties": false
    },
    "IoModuleConfig": {
      "title": "IoModuleConfig",
      "description": "Конфигурация модуля ввода/вывода (IO)",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение модуля на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель модуля IO"
        },
        "Field": {
          "$ref": "#/definitions/FieldRef"
        },
        "Net": {
          "type": "object",
          "description": "Сетевые параметры IO модуля",
          "properties": {
            "IP": {
              "type": "string",
              "description": "IP-адрес модуля"
            },
            "Web": {
              "type": "number",
              "description": "Порт веб-интерфейса"
            }
          },
          "required": ["IP", "Web"],
          "additionalProperties": false
        },
        "DI": {
          "type": "array",
          "description": "Цифровые входы (DI)",
          "items": {
            "$ref": "#/definitions/IoPinSink"
          }
        },
        "DO": {
          "type": "array",
          "description": "Цифровые выходы (DO)",
          "items": {
            "$ref": "#/definitions/IoPinSink"
          }
        },
        "ADC": {
          "type": "array",
          "description": "Аналоговые входы (ADC)",
          "items": {
            "$ref": "#/definitions/IoPinSink"
          }
        }
      },
      "required": ["RefDes", "Model", "Field", "DI", "DO", "ADC"],
      "additionalProperties": false
    },
    "CameraConfig": {
      "title": "CameraConfig",
      "description": "Конфигурация IP-видеокамеры",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение камеры на монтажной схеме"
        },
        "Model": {
          "type": "string",
          "description": "Модель камеры"
        },
        "Lens": {
          "type": "object",
          "description": "Параметры объектива",
          "properties": {
            "Model": {
              "type": "string",
              "description": "Модель объектива"
            },
            "Zoom": {
              "type": "number",
              "description": "Начальная установка зума"
            }
          },
          "required": ["Model", "Zoom"],
          "additionalProperties": false
        },
        "Pan": {
          "type": "number",
          "description": "Стартовое панорамирование"
        },
        "Tilt": {
          "type": "number",
          "description": "Начальная установка наклона"
        },
        "Net": {
          "type": "object",
          "description": "Сетевые параметры камеры",
          "properties": {
            "IP": {
              "type": "string",
              "description": "IP-адрес камеры"
            },
            "RTP": {
              "type": "number",
              "description": "RTP-порт видеопотока"
            }
          },
          "required": ["IP", "RTP"],
          "additionalProperties": false
        }
      },
      "required": ["RefDes", "Model", "Lens", "Pan", "Tilt", "Net"],
      "additionalProperties": false
    },
    "SectionConfig": {
      "title": "SectionConfig",
      "description": "Конфигурация отдельной секции аппарата",
      "type": "object",
      "properties": {
        "Name": {
          "type": "string",
          "description": "Уникальное имя секции (например, 'spiral', 'postomat')"
        },
        "ID": {
          "type": "string",
          "description": "Идентификатор секции (UUID)"
        },
        "Type": {
          "$ref": "#/definitions/SECTION_TYPE"
        },
        "Rows": {
          "type": "number",
          "description": "Число полок в секции"
        },
        "Cols": {
          "type": "number",
          "description": "Число ячеек на полке"
        },
        "IOList": {
          "type": "array",
          "description": "Массив имён модулей ввода-вывода (IO), закреплённых за данной секцией",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["Name", "ID", "Type", "Rows", "Cols", "IOList"],
      "additionalProperties": false
    },
    "NetPowerDeviceConfig": {
      "title": "NetPowerDeviceConfig",
      "description": "Параметры электропитания сетевого устройства",
      "type": "object",
      "properties": {
        "Bus": {
          "type": "number",
          "description": "Номер шины электропитания"
        },
        "Voltage": {
          "type": "number",
          "description": "Напряжение электропитания, В"
        },
        "CurrentMax": {
          "type": "number",
          "description": "Максимальный потребляемый ток, А"
        },
        "Power": {
          "type": "number",
          "description": "Мощность потребления, Вт"
        }
      },
      "required": ["Bus", "Voltage", "CurrentMax", "Power"],
      "additionalProperties": false
    },
    "NetPortConfig": {
      "title": "NetPortConfig",
      "description": "Параметры порта сетевого устройства",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Имя порта"
        },
        "poe": {
          "type": "boolean",
          "description": "Флаг наличия/активности PoE"
        },
        "sink": {
          "type": "array",
          "description": "Список подключенных устройств к порту",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "poe", "sink"],
      "additionalProperties": false
    },
    "WanConfig": {
      "title": "WanConfig",
      "description": "Конфигурация внешнего сетевого интерфейса (WAN)",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Имя uplink-порта"
        },
        "mode": {
          "$ref": "#/definitions/WAN_MODE"
        },
        "ip": {
          "type": "string",
          "description": "IP-адрес (для static режима)"
        },
        "mask": {
          "type": "string",
          "description": "Сетевая маска (для static режима)"
        },
        "gw": {
          "type": "string",
          "description": "Шлюз (для static режима)"
        },
        "dns": {
          "type": "array",
          "description": "Список IP-адресов DNS-серверов",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "mode"],
      "additionalProperties": false
    },
    "RouterConfig": {
      "title": "RouterConfig",
      "description": "Конфигурация сетевого роутера",
      "type": "object",
      "properties": {
        "RefDes": {
          "type": "string",
          "description": "Обозначение роутера на монтажной схеме"
        },
        "Power": {
          "$ref": "#/definitions/NetPowerDeviceConfig"
        },
        "WAN": {
          "$ref": "#/definitions/WanConfig"
        },
