{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NetConfig",
  "description": "Сетевые настройки оборудования и сервисов ПО",
  "type": "object",
  "properties": {
    "Common": {
      "type": "object",
      "description": "Общие сетевые параметры",
      "properties": {
        "Mask": {
          "type": "string",
          "description": "Сетевая маска (например, '255.255.255.0')"
        },
        "GW": {
          "type": "string",
          "description": "Сетевой шлюз"
        }
      },
      "required": [
        "Mask",
        "GW"
      ],
      "additionalProperties": false
    },
    "Router": {
      "$ref": "#/definitions/RouterConfig"
    },
    "Switch": {
      "$ref": "#/definitions/SwitchConfig"
    },
    "Hub": {
      "type": "object",
      "description": "IP-адреса управляющих микрокомпьютеров (хабов)",
      "properties": {
        "Low": {
          "type": "object",
          "properties": {
            "IP": {
              "type": "string"
            },
            "CpuTempChannel": {
              "type": "string",
              "description": "Канал температуры процессора хаба"
            }
          },
          "required": [
            "IP"
          ],
          "additionalProperties": false
        },
        "Mid": {
          "type": "object",
          "properties": {
            "IP": {
              "type": "string"
            }
          },
          "required": [
            "IP"
          ],
          "additionalProperties": false
        },
        "High": {
          "type": "object",
          "properties": {
            "IP": {
              "type": "string"
            }
          },
          "required": [
            "IP"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Low",
        "Mid",
        "High"
      ],
      "additionalProperties": false
    },
    "SW": {
      "type": "object",
      "description": "Сетевые параметры серверного ПО и сервисов",
      "properties": {
        "Low": {
          "type": "object",
          "properties": {
            "Redis": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "Port": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "Port"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "Redis"
          ],
          "additionalProperties": false
        },
        "Mid": {
          "type": "object",
          "properties": {
            "MQTT": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "Port": {
                  "type": "string"
                },
                "WsPort": {
                  "type": "string"
                },
                "ClientUrl": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "Port",
                "WsPort",
                "ClientUrl"
              ],
              "additionalProperties": false
            },
            "MongoDB": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "Port": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "Port"
              ],
              "additionalProperties": false
            },
            "NTP": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "Port": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "Port"
              ],
              "additionalProperties": false
            },
            "Graylog": {
              "type": "object",
              "properties": {
                "IP": {
                  "type": "string"
                },
                "Web": {
                  "type": "object",
                  "properties": {
                    "Port": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "Port"
                  ],
                  "additionalProperties": false
                },
                "Input": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "Port": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "Port"
                    ],
                    "additionalProperties": false
                  }
                },
                "Url": {
                  "type": "string"
                }
              },
              "required": [
                "IP",
                "Web",
                "Input",
                "Url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "MQTT",
            "MongoDB",
            "NTP",
            "Graylog"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Low",
        "Mid"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "Common",
    "Router",
    "Switch",
    "Hub",
    "SW"
  ],
  "additionalProperties": false,
  "definitions": {
    "WAN_MODE": {
      "title": "WAN_MODE",
      "description": "Режим работы WAN-порта (static - статический IP, dhcp - динамический IP)",
      "type": "string",
      "enum": [
        "static",
        "dhcp"
      ],
      "tsEnumNames": [
        "STATIC",
        "DHCP"
      ]
    },
    "NetPowerDeviceConfig": {
      "title": "NetPowerDeviceConfig",
      "description": "Параметры электропитания сетевого устройства",
      "type": "object",
      "properties": {
        "PowerBus": {
          "type": "string",
          "description": "Идентификатор подключенной шины электропитания или ввода (например, MAINS, BUS-1)"
        },
        "Power": {
          "type": "number",
          "description": "Мощность потребления, Вт"
        }
      },
      "required": [
        "PowerBus",
        "Power"
      ],
      "additionalProperties": false
    },
    "NetPortConfig": {
      "title": "NetPortConfig",
      "description": "Параметры порта сетевого устройства",
      "type": "object",
      "properties": {
        "Name": {
          "type": "string",
          "description": "Имя порта"
        },
        "PoE": {
          "type": "boolean",
          "description": "Флаг наличия/активности PoE"
        }
      },
      "required": [
        "Name",
        "PoE"
      ],
      "additionalProperties": false
    },
    "WanConfig": {
      "title": "WanConfig",
      "description": "Конфигурация внешнего сетевого интерфейса (WAN)",
      "type": "object",
      "properties": {
        "Name": {
          "type": "string",
          "description": "Имя uplink-порта"
        },
        "Mode": {
          "$ref": "#/definitions/WAN_MODE"
        },
        "IP": {
          "type": "string",
          "description": "IP-адрес (для static режима)"
        },
        "Mask": {
          "type": "string",
          "description": "Сетевая маска (для static режима)"
        },
        "GW": {
          "type": "string",
          "description": "Шлюз (для static режима)"
        },
        "DNS": {
          "type": "array",
          "description": "Список IP-адресов DNS-серверов",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "Name",
        "Mode"
      ],
      "additionalProperties": false
    },
    "RouterConfig": {
      "title": "RouterConfig",
      "description": "Конфигурация сетевого роутера",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор роутера (например, ROUTER1)"
        },
        "Power": {
          "$ref": "#/definitions/NetPowerDeviceConfig"
        },
        "WAN": {
          "$ref": "#/definitions/WanConfig"
        },
        "Ports": {
          "type": "array",
          "description": "Список портов роутера",
          "items": {
            "$ref": "#/definitions/NetPortConfig"
          }
        }
      },
      "required": [
        "ID",
        "Power",
        "WAN",
        "Ports"
      ],
      "additionalProperties": false
    },
    "SwitchConfig": {
      "title": "SwitchConfig",
      "description": "Конфигурация сетевого коммутатора",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор коммутатора (например, SWITCH1)"
        },
        "Model": {
          "type": "string",
          "description": "Модель коммутатора"
        },
        "PortsTotal": {
          "type": "number",
          "description": "Общее количество портов коммутатора"
        },
        "Power": {
          "$ref": "#/definitions/NetPowerDeviceConfig"
        }
      },
      "required": [
        "ID",
        "Model",
        "PortsTotal",
        "Power"
      ],
      "additionalProperties": false
    }
  }
}
