{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PowerConfig",
  "description": "Конфигурация подсистемы электропитания аппарата",
  "type": "object",
  "properties": {
    "Mains": {
      "$ref": "#/definitions/MainsConfig"
    },
    "Buses": {
      "type": "array",
      "description": "Список распределительных шин электропитания аппарата",
      "items": {
        "$ref": "#/definitions/PowerBusConfig"
      }
    },
    "PSU": {
      "type": "array",
      "description": "Список источников питания (PSU)",
      "items": {
        "$ref": "#/definitions/PsuConfig"
      }
    },
    "UPS": {
      "type": "array",
      "description": "Список модулей источников бесперебойного питания (ИБП / UPS)",
      "items": {
        "$ref": "#/definitions/UpsConfig"
      }
    }
  },
  "required": [
    "Mains",
    "Buses",
    "PSU"
  ],
  "additionalProperties": false,
  "definitions": {
    "BATTERY_TYPE": {
      "title": "BATTERY_TYPE",
      "description": "Тип аккумулятора (lipo - литий-полимерный, lead - свинцово-кислотный)",
      "type": "string",
      "enum": [
        "lipo",
        "lead"
      ],
      "tsEnumNames": [
        "LIPO",
        "LEAD"
      ]
    },
    "MainsConfig": {
      "title": "MainsConfig",
      "description": "Параметры электропитания сети переменного тока",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор первичного сетевого ввода (по умолчанию MAINS)"
        },
        "Voltage": {
          "type": "number",
          "description": "Номинальное сетевое напряжение, В (по умолчанию 230)"
        },
        "VoltageMin": {
          "type": "number",
          "description": "Минимально допустимое сетевое напряжение, В (по умолчанию 170)"
        },
        "VoltageMax": {
          "type": "number",
          "description": "Максимально допустимое сетевое напряжение, В (по умолчанию 250)"
        },
        "CurrentMax": {
          "type": "number",
          "description": "Максимальный сетевой ток, А"
        },
        "PowerMax": {
          "type": "number",
          "description": "Максимальная потребляемая мощность аппарата, Вт (по умолчанию 200)"
        }
      },
      "required": [
        "Voltage",
        "VoltageMin",
        "VoltageMax",
        "PowerMax"
      ],
      "additionalProperties": false
    },
    "BatteryConfig": {
      "title": "BatteryConfig",
      "description": "Параметры резервной аккумуляторной батареи",
      "type": "object",
      "properties": {
        "Model": {
          "type": "string",
          "description": "Модель батареи"
        },
        "Type": {
          "$ref": "#/definitions/BATTERY_TYPE"
        },
        "Voltage": {
          "type": "number",
          "description": "Номинальное напряжение батареи, В"
        },
        "Capacity": {
          "type": "number",
          "description": "Ёмкость батареи, Ач"
        }
      },
      "required": [
        "Model",
        "Type",
        "Voltage",
        "Capacity"
      ],
      "additionalProperties": false
    },
    "PowerBusConfig": {
      "title": "PowerBusConfig",
      "description": "Конфигурация распределительной шины электропитания",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор шины питания (например, BUS-1)"
        },
        "Voltage": {
          "type": "number",
          "description": "Номинальное напряжение шины, В"
        },
        "PSU": {
          "type": "string",
          "description": "Идентификатор источника питания (PSU), формирующего данную шину"
        },
        "UPS": {
          "type": "array",
          "description": "Список идентификаторов модулей ИБП, резервирующих данную шину",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ID",
        "Voltage",
        "PSU"
      ],
      "additionalProperties": false
    },
    "PsuConfig": {
      "title": "PsuConfig",
      "description": "Конфигурация источника питания (ИП / PSU)",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор источника питания (например, PWR3, DRS2)"
        },
        "Model": {
          "type": "string",
          "description": "Модель источника питания"
        },
        "VoltageIn": {
          "type": "number",
          "description": "Входное напряжение, В (по умолчанию 230)"
        },
        "VoltageOut": {
          "type": "number",
          "description": "Выходное напряжение, В"
        },
        "CurrentMax": {
          "type": "number",
          "description": "Ограничение максимального выходного тока, А"
        },
        "Battery": {
          "$ref": "#/definitions/BatteryConfig"
        },
        "Control": {
          "$ref": "./field.schema.json#/definitions/ControlConfig"
        },
        "Channels": {
          "type": "object",
          "description": "Каналы мониторинга источника питания",
          "properties": {
            "VoltageIn": {
              "type": "string",
              "description": "Имя канала входящего напряжения"
            },
            "VoltageOut": {
              "type": "string",
              "description": "Имя канала выходящего напряжения"
            },
            "CurrentOut": {
              "type": "string",
              "description": "Имя канала выходящего тока"
            },
            "Power": {
              "type": "string",
              "description": "Имя канала мощности"
            },
            "Temp": {
              "type": "string",
              "description": "Имя канала температуры"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "ID",
        "Model",
        "VoltageIn",
        "VoltageOut",
        "CurrentMax"
      ],
      "additionalProperties": false
    },
    "UpsConfig": {
      "title": "UpsConfig",
      "description": "Конфигурация модуля источника бесперебойного питания (ИБП / UPS)",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор модуля ИБП (например, UPS1)"
        },
        "Model": {
          "type": "string",
          "description": "Модель модуля ИБП"
        },
        "VoltageIn": {
          "type": "number",
          "description": "Входное напряжение, В"
        },
        "VoltageOut": {
          "type": "number",
          "description": "Выходное напряжение, В"
        },
        "CurrentMax": {
          "type": "number",
          "description": "Максимальный ток, А"
        },
        "Battery": {
          "$ref": "#/definitions/BatteryConfig"
        },
        "Control": {
          "$ref": "./field.schema.json#/definitions/ControlConfig"
        }
      },
      "required": [
        "ID",
        "Model",
        "VoltageIn",
        "VoltageOut",
        "CurrentMax"
      ],
      "additionalProperties": false
    }
  }
}
