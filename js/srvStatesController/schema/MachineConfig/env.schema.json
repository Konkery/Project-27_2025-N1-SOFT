{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvConfig",
  "description": "Конфигурация подсистемы климатического контроля (список датчиков климата аппарата)",
  "type": "array",
  "items": {
    "$ref": "#/definitions/EnvSensorConfig"
  },
  "definitions": {
    "EnvSensorChannelConfig": {
      "title": "EnvSensorChannelConfig",
      "description": "Параметры измерительного канала датчика климата",
      "type": "object",
      "properties": {
        "Name": {
          "type": "string",
          "description": "Имя канала в подсистеме проксирования/мониторинга"
        },
        "Min": {
          "type": "number",
          "description": "Минимальное допустимое рабочее значение"
        },
        "Max": {
          "type": "number",
          "description": "Максимальное допустимое рабочее значение"
        }
      },
      "required": [
        "Name"
      ],
      "additionalProperties": false
    },
    "EnvSensorConfig": {
      "title": "EnvSensorConfig",
      "description": "Конфигурация датчика климатического контроля",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Уникальный идентификатор датчика"
        },
        "Model": {
          "type": "string",
          "description": "Модель датчика"
        },
        "Control": {
          "$ref": "./field.schema.json#/definitions/ControlConfig"
        },
        "WEB_URL": {
          "type": "string",
          "description": "URL-ссылка на веб-интерфейс устройства (при наличии)"
        },
        "Channels": {
          "type": "object",
          "description": "Каналы измерений датчика (например, Temp, Hum)",
          "additionalProperties": {
            "$ref": "#/definitions/EnvSensorChannelConfig"
          }
        }
      },
      "required": [
        "ID",
        "Model",
        "Control",
        "Channels"
      ],
      "additionalProperties": false
    }
  }
}
