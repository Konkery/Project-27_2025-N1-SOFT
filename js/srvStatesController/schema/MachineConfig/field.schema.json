{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FieldBusesConfig",
  "description": "Конфигурация полевых шин аппарата",
  "type": "object",
  "properties": {
    "Gateways": {
      "type": "array",
      "description": "Список сетевых шлюзов и конвертеров интерфейсов (Ethernet to RS485/CAN)",
      "items": {
        "$ref": "#/definitions/GatewayConfig"
      }
    },
    "RS485": {
      "type": "array",
      "description": "Список шин RS485",
      "items": {
        "$ref": "#/definitions/RS485BusConfig"
      }
    },
    "CAN": {
      "type": "array",
      "description": "Список шин CAN",
      "items": {
        "$ref": "#/definitions/CanBusConfig"
      }
    },
    "TCP": {
      "type": "array",
      "description": "Список шин MODBUS/TCP",
      "items": {
        "$ref": "#/definitions/TcpBusConfig"
      }
    }
  },
  "required": [
    "RS485",
    "CAN",
    "TCP"
  ],
  "additionalProperties": false,
  "definitions": {
    "CONTROL_PROTOCOL": {
      "title": "CONTROL_PROTOCOL",
      "description": "Протокол подключения и управления устройством",
      "type": "string",
      "enum": [
        "ModbusRTU",
        "ModbusTCP",
        "HTTP",
        "CAN"
      ],
      "tsEnumNames": [
        "MODBUS_RTU",
        "MODBUS_TCP",
        "HTTP",
        "CAN"
      ]
    },
    "ControlConfig": {
      "title": "ControlConfig",
      "description": "Параметры рабочего канала связи и управления устройством в АСУ",
      "type": "object",
      "properties": {
        "Protocol": {
          "$ref": "#/definitions/CONTROL_PROTOCOL"
        },
        "Bus": {
          "type": "string",
          "description": "Идентификатор полевой шины (RS485 или CAN)"
        },
        "Address": {
          "type": "number",
          "description": "Сетевой адрес устройства (Modbus Slave ID, CAN Node ID)"
        },
        "IP": {
          "type": "string",
          "description": "Сетевой IP-адрес устройства (для ModbusTCP, HTTP)"
        },
        "Port": {
          "type": "number",
          "description": "Сетевой TCP-порт устройства (для ModbusTCP, HTTP)"
        },
        "SSEPath": {
          "type": "string",
          "description": "Относительный URL-путь к потоку Server-Sent Events (для HTTP)"
        }
      },
      "required": [
        "Protocol"
      ],
      "additionalProperties": false
    },
    "GatewayConfig": {
      "title": "GatewayConfig",
      "description": "Конфигурация сетевого конвертера интерфейсов (шлюза)",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Уникальный идентификатор шлюза"
        },
        "Model": {
          "type": "string",
          "description": "Модель конвертера"
        },
        "IP": {
          "type": "string",
          "description": "IP-адрес конвертера в локальной сети"
        },
        "Buses": {
          "type": "object",
          "description": "Маппинг физических портов конвертера на идентификаторы шин RS485/CAN",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "ID",
        "Model",
        "IP",
        "Buses"
      ],
      "additionalProperties": false
    },
    "FieldRef": {
      "title": "FieldRef",
      "description": "Ссылка на подключение устройства к полевой шине (устаревший формат, используйте ControlConfig)",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "description": "Ссылка на полевую шину"
        },
        "ID": {
          "type": "string",
          "description": "Адрес устройства на шине"
        }
      },
      "required": [
        "ref",
        "ID"
      ],
      "additionalProperties": false
    },
    "RS485BusConfig": {
      "title": "RS485BusConfig",
      "description": "Конфигурация полевой шины RS485 (MODBUS/RTU)",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор шины RS485"
        },
        "Master": {
          "type": "string",
          "description": "Мастер-устройство ('hubLow', 'ICP-CON2' и т.д.)"
        },
        "Port": {
          "type": "string",
          "description": "Имя порта на мастере (например, 'PORT1', 'com1')"
        },
        "Baud": {
          "type": "number",
          "description": "Скорость работы порта (бод)"
        },
        "TCPPort": {
          "type": "number",
          "description": "TCP-порт для шлюзов Ethernet-to-Serial (опционально)"
        }
      },
      "required": [
        "ID",
        "Master",
        "Port",
        "Baud"
      ],
      "additionalProperties": false
    },
    "CanBusConfig": {
      "title": "CanBusConfig",
      "description": "Конфигурация полевой шины CAN",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор шины CAN"
        },
        "Master": {
          "type": "string",
          "description": "Мастер-устройство"
        },
        "Port": {
          "type": "string",
          "description": "Имя интерфейса (например, 'can0')"
        },
        "Bitrate": {
          "type": "number",
          "description": "Скорость шины CAN (бод)"
        }
      },
      "required": [
        "ID"
      ],
      "additionalProperties": false
    },
    "TcpBusConfig": {
      "title": "TcpBusConfig",
      "description": "Конфигурация сетевой полевой шины MODBUS/TCP",
      "type": "object",
      "properties": {
        "ID": {
          "type": "string",
          "description": "Идентификатор шины TCP"
        },
        "SubNet": {
          "type": "string",
          "description": "Подсеть MODBUS/TCP"
        }
      },
      "required": [
        "SubNet"
      ],
      "additionalProperties": false
    }
  }
}
