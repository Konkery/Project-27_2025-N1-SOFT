{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IoModuleConfig",
  "description": "Конфигурация модуля ввода/вывода (IO)",
  "type": "object",
  "properties": {
    "ID": {
      "type": "string",
      "description": "Идентификатор модуля ввода-вывода (например, IO-1.1-SPIRAL-ROW)"
    },
    "Model": {
      "type": "string",
      "description": "Модель модуля IO"
    },
    "Control": {
      "$ref": "./field.schema.json#/definitions/ControlConfig"
    },
    "WEB_URL": {
      "type": "string",
      "description": "URL веб-интерфейса модуля IO (опционально)"
    }
  },
  "required": [
    "ID",
    "Model",
    "Control"
  ],
  "additionalProperties": false
}
