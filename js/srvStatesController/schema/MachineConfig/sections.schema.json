{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SectionConfig",
  "description": "Конфигурация отдельной секции аппарата",
  "type": "object",
  "properties": {
    "Name": {
      "type": "string",
      "description": "Уникальное имя секции (например, 'Machine-1-spiral', 'Machine-1-postomat')"
    },
    "ID": {
      "type": "string",
      "description": "Идентификатор секции"
    },
    "Type": {
      "$ref": "#/definitions/SECTION_TYPE"
    },
    "Rows": {
      "type": "number",
      "description": "Число полок в секции"
    },
    "Cols": {
      "type": "number",
      "description": "Число ячеек на полке"
    },
    "PowerBus": {
      "type": [
        "string",
        "number"
      ],
      "description": "Идентификатор или номер подключенной шины электропитания (например, 'BUS-3')"
    },
    "IOList": {
      "type": "array",
      "description": "Массив имён модулей ввода-вывода (IO), закреплённых за данной секцией",
      "items": {
        "type": "string"
      }
    },
    "Channels": {
      "$ref": "#/definitions/SectionChannelsConfig"
    },
    "Lift": {
      "$ref": "#/definitions/SectionLiftConfig"
    }
  },
  "required": [
    "Name",
    "ID",
    "Type",
    "Rows",
    "Cols",
    "PowerBus",
    "IOList",
    "Channels"
  ],
  "additionalProperties": false,
  "definitions": {
    "SECTION_TYPE": {
      "title": "SECTION_TYPE",
      "description": "Тип секции вендингового аппарата (POST - постомат, SPIRAL - спиральная секция, WEIGHT - весовая секция приёма лома, DOZER - диспенсер сыпучих/жидких материалов)",
      "type": "string",
      "enum": [
        "POST",
        "SPIRAL",
        "WEIGHT",
        "DOZER"
      ],
      "tsEnumNames": [
        "POST",
        "SPIRAL",
        "WEIGHT",
        "DOZER"
      ]
    },
    "SectionChannelsConfig": {
      "title": "SectionChannelsConfig",
      "description": "Группа всех каналов ввода/вывода секции",
      "type": "object",
      "properties": {
        "Door": {
          "$ref": "#/definitions/DoorChannelsConfig"
        },
        "DeliveryBox": {
          "$ref": "#/definitions/DeliveryBoxChannelsConfig"
        },
        "Storage": {
          "$ref": "#/definitions/StorageChannelsConfig"
        },
        "Lift": {
          "$ref": "#/definitions/LiftChannelsConfig"
        },
        "Led": {
          "$ref": "#/definitions/LedChannelsConfig"
        },
        "Power": {
          "$ref": "#/definitions/SectionPowerChannelsConfig"
        }
      },
      "additionalProperties": false
    },
    "DoorChannelsConfig": {
      "title": "DoorChannelsConfig",
      "description": "Канал концевика двери секции",
      "type": "object",
      "properties": {
        "Sensor": {
          "type": "string",
          "description": "Канал концевика двери"
        }
      },
      "required": [
        "Sensor"
      ],
      "additionalProperties": false
    },
    "DeliveryBoxChannelsConfig": {
      "title": "DeliveryBoxChannelsConfig",
      "description": "Каналы отсека выдачи товара",
      "type": "object",
      "properties": {
        "Lock": {
          "type": "string",
          "description": "Канал замка / привода шторки отсека выдачи"
        },
        "Optic": {
          "type": "string",
          "description": "Канал оптического датчика наличия / падения товара"
        },
        "Monitoring": {
          "type": "string",
          "description": "Канал мониторинга отсека выдачи"
        }
      },
      "additionalProperties": false
    },
    "StorageChannelsConfig": {
      "title": "StorageChannelsConfig",
      "description": "Каналы полок и ячеек секции",
      "type": "object",
      "properties": {
        "MatrixCtrl": {
          "type": "string",
          "description": "Канал управления матрицей ячеек (спиральная секция)"
        },
        "Rows": {
          "type": "array",
          "description": "Список каналов строк матрицы (постамат)",
          "items": {
            "type": "string"
          }
        },
        "Cols": {
          "type": "array",
          "description": "Список каналов колонок матрицы (постамат)",
          "items": {
            "type": "string"
          }
        },
        "Tamper": {
          "type": "array",
          "description": "Список каналов датчиков состояния ячеек / полок",
          "items": {
            "type": "string"
          }
        },
        "Monitoring": {
          "type": "string",
          "description": "Канал мониторинга ячеек"
        }
      },
      "additionalProperties": false
    },
    "LiftChannelsConfig": {
      "title": "LiftChannelsConfig",
      "description": "Каналы лифта выдачи товаров",
      "type": "object",
      "properties": {
        "MotorCtrl": {
          "type": "string",
          "description": "Канал управления приводом лифта"
        },
        "LevelSensor": {
          "type": "string",
          "description": "Канал оптического датчика позиционирования уровня лифта"
        },
        "BottomTamper": {
          "type": "string",
          "description": "Канал нижнего концевика лифта"
        },
        "TopTamper": {
          "type": "string",
          "description": "Канал верхнего концевика лифта"
        },
        "Monitoring": {
          "type": "string",
          "description": "Канал мониторинга привода лифта"
        }
      },
      "additionalProperties": false
    },
    "LedChannelsConfig": {
      "title": "LedChannelsConfig",
      "description": "Каналы управления подсветкой секции",
      "type": [
        "object",
        "string"
      ],
      "properties": {
        "Ctrl": {
          "type": "string",
          "description": "Канал управления подсветкой секции"
        }
      },
      "additionalProperties": false
    },
    "SectionLiftConfig": {
      "title": "SectionLiftConfig",
      "description": "Параметры механизма лифта",
      "type": "object",
      "properties": {
        "MaxLevel": {
          "type": "number",
          "description": "Максимальный этаж/уровень лифта"
        }
      },
      "required": [
        "MaxLevel"
      ],
      "additionalProperties": false
    },
    "SectionPowerChannelsConfig": {
      "title": "SectionPowerChannelsConfig",
      "description": "Каналы питания секции (контроль тока, напряжения, КЗ и управление питанием приводов)",
      "type": "object",
      "properties": {
        "Current": {
          "type": "string",
          "description": "Канал измерения выходного тока шины/БП"
        },
        "Voltage": {
          "type": "string",
          "description": "Канал измерения выходного напряжения шины/БП"
        },
        "PsuWork": {
          "type": "string",
          "description": "Канал дискретного управления питанием приводов (вкл/выкл)"
        },
        "Short": {
          "type": "string",
          "description": "Канал аварийного сигнала короткого замыкания"
        }
      },
      "required": [
        "Current",
        "Voltage",
        "PsuWork"
      ],
      "additionalProperties": false
    }
  }
}
