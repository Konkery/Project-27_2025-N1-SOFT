{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GlobalMonitoring",
  "description": "JSON Schema для системы глобального мониторинга аппарата (Monitoring)",
  "type": "object",
  "properties": {
    "Global": {
      "type": "object",
      "description": "Глобальные переменные мониторинга аппарата",
      "properties": {
        "Uptime": {
          "type": "object",
          "description": "Показатели наработки аппарата",
          "properties": {
            "Hours": {
              "type": "number",
              "description": "Наработка аппарата, часов"
            },
            "PowerOn": {
              "type": "number",
              "description": "Количество включений аппарата"
            }
          },
          "required": [
            "Hours",
            "PowerOn"
          ],
          "additionalProperties": false
        },
        "Power": {
          "type": "object",
          "description": "Показатели сети электропитания",
          "properties": {
            "MainsVoltage": {
              "type": "number",
              "description": "Числовое значение входного сетевого напряжения, В"
            },
            "Consumption": {
              "type": "number",
              "description": "Текущая потребляемая активная мощность, Вт"
            }
          },
          "required": [
            "MainsVoltage",
            "Consumption"
          ],
          "additionalProperties": false
        },
        "Energy": {
          "type": "object",
          "description": "Показатели потреблённой активной энергии",
          "properties": {
            "Day": {
              "type": "number",
              "description": "Потреблённая активная энергия за текущие сутки, Вт·ч"
            },
            "Week": {
              "type": "number",
              "description": "Потреблённая активная энергия за неделю, Вт·ч"
            },
            "Month": {
              "type": "number",
              "description": "Потреблённая активная энергия за месяц, Вт·ч"
            }
          },
          "required": [
            "Day",
            "Week",
            "Month"
          ],
          "additionalProperties": false
        },
        "Env": {
          "type": "object",
          "description": "Усредненные измерения датчиков окружающей среды",
          "properties": {
            "Temp": {
              "type": "number",
              "description": "Усреднённое значение температуры окружающей среды, °C"
            },
            "Hum": {
              "type": "number",
              "description": "Усреднённое значение влажности окружающей среды, %"
            }
          },
          "required": [
            "Temp",
            "Hum"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Uptime",
        "Power",
        "Energy",
        "Env"
      ],
      "additionalProperties": false
    },
    "Hub": {
      "type": "object",
      "description": "Переменные мониторинга хабов",
      "properties": {
        "Low": {
          "type": "object",
          "description": "Хаб нижнего уровня (НУ)",
          "properties": {
            "Temp": {
              "type": "number",
              "description": "Текущая температура CPU хаба НУ, °C"
            }
          },
          "required": [
            "Temp"
          ],
          "additionalProperties": false
        },
        "Mid": {
          "type": "object",
          "description": "Хаб среднего уровня (СУ)",
          "properties": {
            "Temp": {
              "type": "number",
              "description": "Текущая температура CPU хаба СУ, °C"
            }
          },
          "required": [
            "Temp"
          ],
          "additionalProperties": false
        },
        "Hi": {
          "type": "object",
          "description": "Хаб верхнего уровня (ВУ)",
          "properties": {
            "Temp": {
              "type": "number",
              "description": "Текущая температура CPU хаба ВУ, °C"
            }
          },
          "required": [
            "Temp"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "Low",
        "Mid",
        "Hi"
      ],
      "additionalProperties": false
    },
    "UPS": {
      "type": "array",
      "description": "Переменные измерений и наработки резервированных источников питания (ИБП)",
      "items": {
        "$ref": "#/definitions/UpsMonitoring"
      }
    },
    "Bus": {
      "type": "array",
      "description": "Переменные измерений шин электропитания",
      "items": {
        "$ref": "#/definitions/BusMonitoring"
      }
    },
    "PSU": {
      "type": "array",
      "description": "Переменные измерений и наработки источников питания (ИП)",
      "items": {
        "$ref": "#/definitions/PsuMonitoring"
      }
    },
    "Sections": {
      "type": "array",
      "description": "Переменные наработки и измерений секций аппарата",
      "items": {
        "anyOf": [
          {
            "$ref": "./spiral_section_monitoring.schema.json"
          },
          {
            "$ref": "./base_section_monitoring.schema.json"
          }
        ]
      }
    }
  },
  "required": [
    "Global",
    "Hub",
    "UPS",
    "Bus",
    "PSU",
    "Sections"
  ],
  "additionalProperties": false,
  "definitions": {
    "BusMonitoring": {
      "title": "BusMonitoring",
      "description": "Параметры измерений шины электропитания",
      "type": "object",
      "properties": {
        "Voltage": {
          "type": "number",
          "description": "Числовое значение напряжения на шине, В"
        },
        "Current": {
          "type": "number",
          "description": "Числовое значение тока на шине, А"
        }
      },
      "required": [
        "Voltage",
        "Current"
      ],
      "additionalProperties": false
    },
    "UpsBatteryUptimeMonitoring": {
      "title": "UpsBatteryUptimeMonitoring",
      "description": "Показатели наработки аккумулятора ИБП",
      "type": "object",
      "properties": {
        "Hours": {
          "type": "number",
          "description": "Общее время эксплуатации аккумулятора, часов"
        },
        "HoursMax": {
          "type": "number",
          "description": "Максимальное время эксплуатации аккумулятора до замены, часов"
        },
        "NumTransfers": {
          "type": "number",
          "description": "Количество переходов на питание аппарата от аккумулятора"
        },
        "RuntimeTotal": {
          "type": "number",
          "description": "Общее время работы аппарата от аккумулятора, часов"
        }
      },
      "required": [
        "Hours",
        "HoursMax",
        "NumTransfers",
        "RuntimeTotal"
      ],
      "additionalProperties": false
    },
    "UpsUptimeMonitoring": {
      "title": "UpsUptimeMonitoring",
      "description": "Показатели наработки ИБП",
      "type": "object",
      "properties": {
        "Hours": {
          "type": "number",
          "description": "Наработка, часов"
        },
        "HoursMax": {
          "type": "number",
          "description": "Моторесурс работы ИП в штатном режиме, часов"
        },
        "OVCcount": {
          "type": "number",
          "description": "Наработка в перегрузке по току, часов"
        },
        "OVTcount": {
          "type": "number",
          "description": "Наработка в перегреве, часов"
        },
        "Battery": {
          "$ref": "#/definitions/UpsBatteryUptimeMonitoring"
        }
      },
      "required": [
        "Hours",
        "HoursMax",
        "OVCcount",
        "OVTcount",
        "Battery"
      ],
      "additionalProperties": false
    },
    "UpsMonitoring": {
      "title": "UpsMonitoring",
      "description": "Переменные измерений и наработки резервированного источника питания (ИБП)",
      "type": "object",
      "properties": {
        "VoltageIn": {
          "type": "number",
          "description": "Числовое значение входного напряжения, В"
        },
        "VoltageOut": {
          "type": "number",
          "description": "Числовое значение выходного напряжения, В"
        },
        "CurrentOut": {
          "type": "number",
          "description": "Числовое значение выходного тока, А"
        },
        "Temp": {
          "type": "number",
          "description": "Числовое значение температуры ИП, °C"
        },
        "Uptime": {
          "$ref": "#/definitions/UpsUptimeMonitoring"
        }
      },
      "required": [
        "VoltageIn",
        "VoltageOut",
        "CurrentOut",
        "Temp",
        "Uptime"
      ],
      "additionalProperties": false
    },
    "PsuUptimeMonitoring": {
      "title": "PsuUptimeMonitoring",
      "description": "Показатели наработки источника питания (ИП)",
      "type": "object",
      "properties": {
        "Hours": {
          "type": "number",
          "description": "Наработка ИП, часов"
        },
        "HoursMax": {
          "type": "number",
          "description": "Моторесурс работы ИП в штатном режиме, часов"
        },
        "OVCcount": {
          "type": "number",
          "description": "Наработка в режиме перегрузки по току, часов"
        },
        "OVTcount": {
          "type": "number",
          "description": "Наработка в режиме перегрева, часов"
        }
      },
      "required": [
        "Hours",
        "HoursMax",
        "OVCcount",
        "OVTcount"
      ],
      "additionalProperties": false
    },
    "PsuMonitoring": {
      "title": "PsuMonitoring",
      "description": "Переменные измерений и наработки источника питания (ИП)",
      "type": "object",
      "properties": {
        "VoltageIn": {
          "type": "number",
          "description": "Числовое значение входного напряжения, В"
        },
        "VoltageOut": {
          "type": "number",
          "description": "Числовое значение выходного напряжения, В"
        },
        "CurrentOut": {
          "type": "number",
          "description": "Числовое значение выходного тока, А"
        },
        "Temp": {
          "type": "number",
          "description": "Числовое значение температуры ИП, °C"
        },
        "Uptime": {
          "$ref": "#/definitions/PsuUptimeMonitoring"
        }
      },
      "required": [
        "VoltageIn",
        "VoltageOut",
        "CurrentOut",
        "Temp",
        "Uptime"
      ],
      "additionalProperties": false
    }
  }
}
