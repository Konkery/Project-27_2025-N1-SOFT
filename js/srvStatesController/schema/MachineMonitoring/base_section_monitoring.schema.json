{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BaseSectionMonitoring",
  "description": "JSON Schema для базового мониторинга секции (BaseSectionMonitoring)",
  "type": "object",
  "properties": {
    "Uptime": {
      "$ref": "#/definitions/SectionUptimeMonitoring"
    },
    "Cells": {
      "type": "array",
      "description": "Массив наработки ячеек секции",
      "items": {
        "type": "object",
        "properties": {
          "Uptime": {
            "$ref": "#/definitions/CellUptimeMonitoring"
          }
        },
        "required": [
          "Uptime"
        ],
        "additionalProperties": false
      }
    },
    "IO": {
      "type": "object",
      "description": "Переменные наработки модулей ввода-вывода (IO)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Uptime": {
            "$ref": "#/definitions/IoUptimeMonitoring"
          }
        },
        "required": [
          "Uptime"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "Uptime",
    "Cells"
  ],
  "definitions": {
    "SectionUptimeMonitoring": {
      "title": "SectionUptimeMonitoring",
      "description": "Показатели наработки подсветки секции",
      "type": "object",
      "properties": {
        "Light": {
          "type": "number",
          "description": "Время работы подсветки секции, часов"
        },
        "LightMax": {
          "type": "number",
          "description": "Максимальное время работы подсветки секции до замены, часов"
        }
      },
      "required": [
        "Light",
        "LightMax"
      ],
      "additionalProperties": false
    },
    "CellUptimeMonitoring": {
      "title": "CellUptimeMonitoring",
      "description": "Показатели наработки ячейки секции",
      "type": "object",
      "properties": {
        "Cell": {
          "type": "number",
          "description": "Наработка ячейки (замка для постаматной, моторчика для спиральной), операций"
        },
        "CellMax": {
          "type": "number",
          "description": "Максимальная наработка ячейки до замены, операций"
        },
        "Door": {
          "type": "number",
          "description": "Количество открытий дверки постаматной ячейки, операций"
        },
        "DoorMax": {
          "type": "number",
          "description": "Максимальное количество открытий дверки постаматной ячейки до замены, операций"
        },
        "Light": {
          "type": "number",
          "description": "Время работы подсветки ячейки, часов"
        },
        "LightMax": {
          "type": "number",
          "description": "Максимальное время работы подсветки ячейки до замены, часов"
        }
      },
      "required": [
        "Cell",
        "CellMax",
        "Door",
        "DoorMax",
        "Light",
        "LightMax"
      ],
      "additionalProperties": false
    },
    "IoUptimeMonitoring": {
      "title": "IoUptimeMonitoring",
      "description": "Показатели наработки модуля ввода-вывода (IO)",
      "type": "object",
      "properties": {
        "Hours": {
          "type": "number",
          "description": "Наработка, часов"
        },
        "HoursMax": {
          "type": "number",
          "description": "Типичная наработка до замены, часов"
        }
      },
      "required": [
        "Hours",
        "HoursMax"
      ],
      "additionalProperties": false
    }
  }
}
