{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpiralSectionMonitoring",
  "description": "JSON Schema для мониторинга спиральной секции (SpiralSectionMonitoring), расширяющая базовую схему мониторинга секции",
  "allOf": [
    {
      "$ref": "./base_section_monitoring.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "Lift": {
          "$ref": "#/definitions/LiftMonitoring"
        },
        "DeliveryBox": {
          "$ref": "#/definitions/DeliveryBoxMonitoring"
        }
      },
      "required": [
        "Lift",
        "DeliveryBox"
      ]
    }
  ],
  "definitions": {
    "LiftUptimeMonitoring": {
      "title": "LiftUptimeMonitoring",
      "description": "Показатели наработки узлов лифта",
      "type": "object",
      "properties": {
        "Lift": {
          "type": "number",
          "description": "Наработка механизма лифта, операций"
        },
        "LiftMax": {
          "type": "number",
          "description": "Типичная наработка механизма лифта до замены, операций"
        },
        "Motor": {
          "type": "number",
          "description": "Наработка двигателя лифта, операций"
        },
        "MotorMax": {
          "type": "number",
          "description": "Типичная наработка двигателя лифта до замены, операций"
        },
        "Reducer": {
          "type": "number",
          "description": "Наработка редуктора лифта, операций"
        },
        "ReducerMax": {
          "type": "number",
          "description": "Типичная наработка редуктора лифта до замены, операций"
        },
        "Drive": {
          "type": "number",
          "description": "Наработка роликов и приводного ремня механизма лифта, операций"
        },
        "DriveMax": {
          "type": "number",
          "description": "Типичная наработка роликов и приводного ремня механизма лифта до замены, операций"
        }
      },
      "required": [
        "Lift",
        "LiftMax",
        "Motor",
        "MotorMax",
        "Reducer",
        "ReducerMax",
        "Drive",
        "DriveMax"
      ],
      "additionalProperties": false
    },
    "LiftMonitoring": {
      "title": "LiftMonitoring",
      "description": "Переменные наработки лифта секции",
      "type": "object",
      "properties": {
        "Uptime": {
          "$ref": "#/definitions/LiftUptimeMonitoring"
        }
      },
      "required": [
        "Uptime"
      ],
      "additionalProperties": false
    },
    "DeliveryBoxUptimeMonitoring": {
      "title": "DeliveryBoxUptimeMonitoring",
      "description": "Показатели наработки лючка выдачи",
      "type": "object",
      "properties": {
        "Lock": {
          "type": "number",
          "description": "Наработка замка лючка выдачи, операций"
        },
        "LockMax": {
          "type": "number",
          "description": "Типичная наработка замка лючка выдачи до замены, операций"
        },
        "Door": {
          "type": "number",
          "description": "Наработка двери лючка выдачи, операций"
        },
        "DoorMax": {
          "type": "number",
          "description": "Типичная наработка двери лючка выдачи до замены, операций"
        }
      },
      "required": [
        "Lock",
        "LockMax",
        "Door",
        "DoorMax"
      ],
      "additionalProperties": false
    },
    "DeliveryBoxMonitoring": {
      "title": "DeliveryBoxMonitoring",
      "description": "Переменные наработки лючка выдачи",
      "type": "object",
      "properties": {
        "Uptime": {
          "$ref": "#/definitions/DeliveryBoxUptimeMonitoring"
        }
      },
      "required": [
        "Uptime"
      ],
      "additionalProperties": false
    }
  }
}
